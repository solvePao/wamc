<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Wamc" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/dashboard_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/dashboard_background</item>
        <item name="android:statusBarColor">@color/dashboard_background</item>
        <item name="android:navigationBarColor">@color/dashboard_background</item>
        <item name="android:colorControlNormal">@color/dashboard_muted</item>
        <item name="android:colorControlActivated">@color/dashboard_accent</item>
        <item name="android:textColorPrimary">@color/dashboard_text</item>
        <item name="android:textColorSecondary">@color/dashboard_muted</item>
        <item name="android:colorBackground">@color/dashboard_surface</item>
    </style>
    <style name="Dashboard.Button" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/dashboard_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Dashboard.Switch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:textColor">@color/dashboard_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:switchPadding">16dp</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>
    <style name="Dashboard.FieldLabel" parent="">
        <item name="android:textColor">@color/dashboard_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">8dp</item>
    </style>
</resources>
